# 复制为 .env，所有者 adbot:adbot，权限600。不要提交真实Token。
BOT_TOKEN=123456789:REPLACE_WITH_BOTFATHER_TOKEN
ADMIN_IDS=100000001,100000002
DATABASE_URL=postgresql://adbot@/auto_ad?host=/var/run/postgresql
TZ=Asia/Shanghai
POLL_TIMEOUT=25
WORKERS=8
PYTHONDONTWRITEBYTECODE=1
# 可选：系统DNS异常时填已核实的api.telegram.org IP，逗号分隔；留空使用系统解析。
# 仅本进程生效，HTTPS域名和TLS证书验证保持启用；地址变动时重新核实。
TELEGRAM_API_IPS=
# 必须独立生成并私下备份的 Fernet 密钥；只用于加密支付凭据，丢失后旧订单无法解密查单。
# 使用 .venv/bin/python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
BILLING_ENCRYPTION_KEY=
